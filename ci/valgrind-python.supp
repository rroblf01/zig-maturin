# Valgrind suppressions for running the CPython interpreter under Valgrind.
#
# These hide known, harmless allocations made by CPython itself during startup,
# import, and teardown so the leak-check job only flags *definite* leaks coming
# from the Zig extension. Keep this list tight — do not suppress leaks whose
# stack trace runs through pyo3zig_*/the extension module.

{
   cpython-interpreter-init
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   ...
   fun:_PyRuntime_Initialize
}
{
   cpython-pymain-run
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   ...
   fun:pymain_run_python
}
{
   cpython-import-machinery
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   ...
   fun:_PyImport_LoadDynamicModuleWithSpec
}
{
   cpython-obmalloc-arena
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   fun:malloc
   ...
   fun:_PyObject_Malloc
}
{
   dlopen-extension-load
   Memcheck:Leak
   match-leak-kinds: definite,possible,reachable
   ...
   fun:dlopen*
}
