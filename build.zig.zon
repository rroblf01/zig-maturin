.{
    .name = .zig_maturin,
    .version = "1.0.1",
    .minimum_zig_version = "0.14.0",
    .fingerprint = 0xdec65ed242b41b61,
    .paths = .{
        "build.zig",
        "build.zig.zon",
        "root.zig",
        "pytypes.zig",
        "pycall.zig",
        "pyo3zig_capi.c",
        "example.zig",
        // The whole high-level layer. List the directory (not individual
        // files) so a newly added module is packaged automatically — a
        // missing entry here makes `zig fetch` ship an incomplete dependency
        // that fails to compile with FileNotFound on the omitted import.
        "pyo3zig",
    },
}
